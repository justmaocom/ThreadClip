{
  "manifest_version": 3,
  "name": "ThreadClip",
  "version": "1.0.0",
  "description": "在 Threads 貼文的影片上加入下載按鈕",
  "homepage_url": "https://justmao.com",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "offscreen"],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.com/*",
        "https://threads.com/*",
        "https://www.threads.net/*",
        "https://threads.net/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
